# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_system

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=school:
REDIS_DEFAULT_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_CONNECTION_TIMEOUT=10000
REDIS_MAX_CONNECTIONS=10

# Cache Configuration
CACHE_ENABLED=true
CACHE_STATS_TTL=300
CACHE_STRATEGIES_TTL=600
CACHE_USER_TTL=1800
CACHE_PAYMENTS_TTL=900
CACHE_SESSIONS_TTL=3600

# Session
SECRET_KEY=your-super-secret-key-change-in-production

# Stripe
STRIPE_SECRET_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_ID=price_your_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Client URL
CLIENT_URL=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development